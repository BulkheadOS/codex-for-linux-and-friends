#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="${CODEX_LINUX_PROJECT_DIR:-$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)}"
PATCHER="$PROJECT_DIR/src/patchers/codex-linux-patcher.mjs"
METADATA_CLI="$PROJECT_DIR/lib/upstream-metadata.mjs"
DESKTOP_TEMPLATE="$PROJECT_DIR/templates/codex-for-linux.desktop.in"
FALLBACK_ICON="$PROJECT_DIR/packaging/flatpak/com.bulkheados.CodexForLinux.svg"

APP_ID="com.bulkheados.CodexForLinux"
APP_NAME="Codex for Linux and friends"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

OUTPUT_ROOT="${CODEX_LINUX_OUTPUT_ROOT:-$DATA_HOME/codex-for-linux}"
INSTALL_DIR="${CODEX_LINUX_INSTALL_DIR:-$OUTPUT_ROOT/runtime}"
CACHE_DIR="${CODEX_LINUX_CACHE_DIR:-$CACHE_HOME/codex-for-linux}"
STATE_DIR="${CODEX_LINUX_STATE_DIR:-$STATE_HOME/codex-for-linux}"
LOG_DIR="$STATE_DIR/logs"
DESKTOP_FILE_PATH="${CODEX_LINUX_DESKTOP_FILE_PATH:-$DATA_HOME/applications/codex-for-linux.desktop}"

WORK_DIR=""
BUILD_INSTALL_DIR=""
SEVEN_ZIP_CMD=""
DMG_PATH=""
FRESH=0
FORCE=0
SKIP_DESKTOP=0
PRINT_JSON=0

red=$'\033[0;31m'
green=$'\033[0;32m'
yellow=$'\033[1;33m'
plain=$'\033[0m'

log() {
  printf '%s[INFO]%s %s\n' "$green" "$plain" "$*" >&2
}

warn() {
  printf '%s[WARN]%s %s\n' "$yellow" "$plain" "$*" >&2
}

die() {
  printf '%s[ERROR]%s %s\n' "$red" "$plain" "$*" >&2
  exit 1
}

cleanup() {
  if [ -n "${WORK_DIR:-}" ] && [ -d "$WORK_DIR" ]; then
    rm -rf "$WORK_DIR"
  fi
  if [ -n "${BUILD_INSTALL_DIR:-}" ] && [ -d "$BUILD_INSTALL_DIR" ]; then
    rm -rf "$BUILD_INSTALL_DIR"
  fi
}

trap cleanup EXIT
trap 'die "Failed at line $LINENO (exit code $?)"' ERR

usage() {
  cat <<'EOF'
Codex for Linux and friends

Unofficial local compatibility builder for the OpenAI Codex desktop app.
It does not redistribute OpenAI binaries. It downloads or consumes an official DMG,
builds a private Linux runtime, and installs a user-level launcher.

Usage:
  codex-linux install [options]
  codex-linux update [options]
  codex-linux launch
  codex-linux status [--json]
  codex-linux diagnostics [--json]
  codex-linux doctor
  codex-linux uninstall

Options:
  --dmg PATH            Use a local Codex.dmg instead of downloading one.
  --fresh              Remove cached/generated runtime first.
  --force              Force update even if the upstream headers look unchanged.
  --skip-desktop       Do not install or refresh the desktop entry.
  --json               Print machine-readable status where supported.
  -h, --help           Show this help.

Environment:
  CODEX_CLI_PATH              Path to an installed codex CLI.
  CODEX_DMG_URL               Override the official DMG URL.
  CODEX_ELECTRON_VERSION      Override detected Electron version.
  CODEX_BETTER_SQLITE3_VERSION Override better-sqlite3 rebuild version.
  CODEX_LINUX_CC              Override the C compiler used for native rebuilds.
  CODEX_LINUX_CXX             Override the C++ compiler used for native rebuilds.
  CODEX_KDE_WAYLAND_ALLOW_UNSAFE
                              Unsafe maintainer-only KDE Wayland crash-guard override.
  CODEX_KWIN_ALLOW_UNSAFE     Alias for CODEX_KDE_WAYLAND_ALLOW_UNSAFE.
  CODEX_INOTIFY_PRESSURE_ALLOW_UNSAFE
                              Unsafe maintainer-only override for high inotify pressure.
  CODEX_INOTIFY_GUARD_THRESHOLD_PERCENT
                              Inotify pressure launch guard threshold, default 90.
  CODEX_WEBVIEW_PORT          Local webview helper port, default 5175.
  CODEX_LINUX_OUTPUT_ROOT     Runtime output root.
  CODEX_LINUX_INSTALL_DIR     Runtime install directory.
  CODEX_LINUX_CACHE_DIR       Download cache directory.
EOF
}

parse_options() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dmg)
        [ "$#" -ge 2 ] || die "--dmg requires a path"
        DMG_PATH="$2"
        shift
        ;;
      --fresh)
        FRESH=1
        ;;
      --force)
        FORCE=1
        ;;
      --skip-desktop)
        SKIP_DESKTOP=1
        ;;
      --json)
        PRINT_JSON=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option: $1"
        ;;
    esac
    shift
  done
}

package_hint() {
  cat <<'EOF'
Install required tools with one of:
  Ubuntu/Kubuntu/Linux Mint: sudo apt install coreutils curl unzip p7zip-full python3 build-essential desktop-file-utils
  SteamOS/Arch/Manjaro:      sudo pacman -S --needed coreutils curl unzip p7zip python base-devel desktop-file-utils
  Fedora:                   sudo dnf install coreutils curl unzip p7zip p7zip-plugins python3 make gcc-c++ desktop-file-utils

Node.js 20+ with npm/npx is also required. Homebrew, fnm, nvm, asdf, or your distro
packages are all fine as long as node, npm, and npx are on PATH.
EOF
}

detect_7zip() {
  if command -v 7zz >/dev/null 2>&1; then
    SEVEN_ZIP_CMD="7zz"
  elif command -v 7z >/dev/null 2>&1; then
    SEVEN_ZIP_CMD="7z"
  else
    return 1
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1
}

node_major() {
  node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf '0\n'
}

doctor_impl() {
  local missing=()
  local major=0

  [ "$(uname -s)" = "Linux" ] || die "This builder is intended to run on Linux."

  for cmd in curl node npm npx python3 unzip make setsid sha256sum; do
    require_command "$cmd" || missing+=("$cmd")
  done

  if [ -n "${CODEX_LINUX_CC:-}" ]; then
    resolve_host_compiler CODEX_LINUX_CC "$CODEX_LINUX_CC" gcc >/dev/null
  else
    require_command gcc || missing+=("gcc")
  fi

  if [ -n "${CODEX_LINUX_CXX:-}" ]; then
    resolve_host_compiler CODEX_LINUX_CXX "$CODEX_LINUX_CXX" g++ >/dev/null
  else
    require_command g++ || missing+=("g++")
  fi

  detect_7zip || missing+=("7z or 7zz")

  if [ "${#missing[@]}" -gt 0 ]; then
    package_hint >&2
    die "Missing dependencies: ${missing[*]}"
  fi

  major="$(node_major)"
  [ "$major" -ge 20 ] || die "Node.js 20+ is required. Found $(node -v 2>/dev/null || echo unknown)."

  if "$SEVEN_ZIP_CMD" | head -n 1 | grep -q '16\.02'; then
    die "Your 7-Zip build is too old for current APFS DMGs. Install p7zip 17+ or 7zz."
  fi

  log "Dependency check passed."
  log "Using $SEVEN_ZIP_CMD, Node $(node -v), npm $(npm -v)."
}

metadata_field() {
  local field="$1"
  local fallback="$2"

  if [ ! -f "$INSTALL_DIR/metadata.json" ]; then
    printf '%s\n' "$fallback"
    return
  fi

  node - "$INSTALL_DIR/metadata.json" "$field" "$fallback" <<'NODE'
const fs = require("fs");
const [metadataPath, field, fallback] = process.argv.slice(2);
try {
  const metadata = JSON.parse(fs.readFileSync(metadataPath, "utf8"));
  const value = metadata[field];
  console.log(value == null || value === "" ? fallback : String(value));
} catch {
  console.log(fallback);
}
NODE
}

runtime_installed() {
  [ -x "$INSTALL_DIR/start.sh" ] && [ -f "$INSTALL_DIR/metadata.json" ]
}

runtime_has_kde_wayland_guard() {
  [ -f "$INSTALL_DIR/start.sh" ] || return 1
  grep -q 'block_kde_wayland_launch' "$INSTALL_DIR/start.sh" &&
    grep -q 'CODEX_KDE_WAYLAND_ALLOW_UNSAFE' "$INSTALL_DIR/start.sh"
}

host_is_wayland_session() {
  [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

host_is_kde_wayland_session() {
  local desktop_values
  local desktop_lc

  host_is_wayland_session || return 1

  if [ "${KDE_FULL_SESSION:-}" = "true" ] || [ -n "${KDE_SESSION_VERSION:-}" ]; then
    return 0
  fi

  desktop_values="${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:${DESKTOP_SESSION:-}"
  desktop_lc="$(printf '%s' "$desktop_values" | tr '[:upper:]' '[:lower:]')"
  case "$desktop_lc" in
    *kde*|*plasma*)
      return 0
      ;;
  esac

  return 1
}

host_kde_wayland_unsafe_allowed() {
  [ "${CODEX_KDE_WAYLAND_ALLOW_UNSAFE:-0}" = "1" ] || [ "${CODEX_KWIN_ALLOW_UNSAFE:-0}" = "1" ]
}

diagnostic_is_unsigned_integer() {
  case "${1:-}" in
    ""|*[!0-9]*)
      return 1
      ;;
    0|[1-9]*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

diagnostic_runtime_process_counts() {
  local electron_count=0
  local crashpad_count=0
  local webview_count=0
  local proc
  local cmdline
  local webview_port="${CODEX_WEBVIEW_PORT:-5175}"
  local proc_cwd

  for proc in /proc/[0-9]*; do
    [ -d "$proc" ] || continue
    [ -r "$proc/cmdline" ] || continue
    cmdline="$(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null || true)"
    [ -n "$cmdline" ] || continue

    case "$cmdline" in
      *"$INSTALL_DIR/electron"*)
        electron_count=$((electron_count + 1))
        ;;
    esac
    case "$cmdline" in
      *"$INSTALL_DIR/chrome_crashpad_handler"*)
        crashpad_count=$((crashpad_count + 1))
        ;;
    esac
    case "$cmdline" in
      *"python3 -m http.server $webview_port"*"--bind 127.0.0.1"*)
        proc_cwd="$(readlink -f "$proc/cwd" 2>/dev/null || true)"
        if [ "$proc_cwd" = "$INSTALL_DIR/content/webview" ]; then
          webview_count=$((webview_count + 1))
        fi
        ;;
    esac
  done

  printf '%s %s %s\n' "$electron_count" "$crashpad_count" "$webview_count"
}

diagnostic_runtime_memory_snapshot() {
  local process_count=0
  local rss_kib_total=0
  local max_rss_kib=0
  local proc
  local cmdline
  local webview_port="${CODEX_WEBVIEW_PORT:-5175}"
  local proc_cwd
  local matched
  local rss_kib

  if [ -n "${CODEX_LINUX_MEMORY_FIXTURE:-}" ]; then
    printf '%s\n' "$CODEX_LINUX_MEMORY_FIXTURE"
    return
  fi

  for proc in /proc/[0-9]*; do
    [ -d "$proc" ] || continue
    [ -r "$proc/cmdline" ] || continue
    [ -r "$proc/status" ] || continue
    cmdline="$(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null || true)"
    [ -n "$cmdline" ] || continue
    matched=0

    case "$cmdline" in
      *"$INSTALL_DIR/electron"*|*"$INSTALL_DIR/chrome_crashpad_handler"*)
        matched=1
        ;;
    esac
    case "$cmdline" in
      *"python3 -m http.server $webview_port"*"--bind 127.0.0.1"*)
        proc_cwd="$(readlink -f "$proc/cwd" 2>/dev/null || true)"
        if [ "$proc_cwd" = "$INSTALL_DIR/content/webview" ]; then
          matched=1
        fi
        ;;
    esac

    [ "$matched" -eq 1 ] || continue
    rss_kib="$(awk '/^VmRSS:/ {print $2; exit}' "$proc/status" 2>/dev/null || true)"
    diagnostic_is_unsigned_integer "$rss_kib" || rss_kib=0
    process_count=$((process_count + 1))
    rss_kib_total=$((rss_kib_total + rss_kib))
    if [ "$rss_kib" -gt "$max_rss_kib" ]; then
      max_rss_kib="$rss_kib"
    fi
  done

  printf '%s %s %s\n' "$process_count" "$rss_kib_total" "$max_rss_kib"
}

diagnostic_webview_port_status() {
  local webview_port="${CODEX_WEBVIEW_PORT:-5175}"

  if ! command -v node >/dev/null 2>&1; then
    printf 'unknown\n'
    return
  fi

  node - "$webview_port" <<'NODE'
const net = require("net");
const port = Number(process.argv[2]);

if (!Number.isInteger(port) || port < 1 || port > 65535) {
  console.log("unknown");
  process.exit(0);
}

let finished = false;
const socket = net.createConnection({ host: "127.0.0.1", port });

function finish(status) {
  if (finished) return;
  finished = true;
  socket.destroy();
  console.log(status);
}

socket.setTimeout(250, () => finish("unknown"));
socket.once("connect", () => finish("open"));
socket.once("error", (error) => {
  if (error && ["ECONNREFUSED", "EHOSTUNREACH", "ENETUNREACH"].includes(error.code)) {
    finish("closed");
    return;
  }
  finish("unknown");
});
NODE
}

diagnostic_read_inotify_limit() {
  local file="$1"
  local value

  if [ -r "$file" ]; then
    value="$(tr -d '[:space:]' <"$file")"
    if diagnostic_is_unsigned_integer "$value"; then
      printf '%s\n' "$value"
      return
    fi
  fi

  printf 'unknown\n'
}

diagnostic_inotify_limits() {
  if [ -n "${CODEX_LINUX_INOTIFY_LIMITS_FIXTURE:-}" ]; then
    printf '%s\n' "$CODEX_LINUX_INOTIFY_LIMITS_FIXTURE"
    return
  fi

  printf '%s %s\n' \
    "$(diagnostic_read_inotify_limit /proc/sys/fs/inotify/max_user_instances)" \
    "$(diagnostic_read_inotify_limit /proc/sys/fs/inotify/max_user_watches)"
}

diagnostic_current_user_inotify_usage() {
  local user_uid
  local instances=0
  local watches=0
  local fd
  local fdinfo
  local watch_count

  if [ -n "${CODEX_LINUX_INOTIFY_USAGE_FIXTURE:-}" ]; then
    printf '%s\n' "$CODEX_LINUX_INOTIFY_USAGE_FIXTURE"
    return
  fi

  if ! command -v find >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
    printf 'unknown unknown\n'
    return
  fi

  user_uid="$(id -u 2>/dev/null || printf '')"
  [ -n "$user_uid" ] || {
    printf 'unknown unknown\n'
    return
  }

  while IFS= read -r fd; do
    [ -n "$fd" ] || continue
    instances=$((instances + 1))
    fdinfo="${fd/\/fd\//\/fdinfo\/}"
    if [ -r "$fdinfo" ]; then
      watch_count="$(awk 'BEGIN { count = 0 } /^inotify/ { count++ } END { print count }' "$fdinfo" 2>/dev/null || printf '0')"
      if diagnostic_is_unsigned_integer "$watch_count"; then
        watches=$((watches + watch_count))
      fi
    fi
  done < <(find /proc/[0-9]*/fd -maxdepth 1 -user "$user_uid" -lname 'anon_inode:inotify' -print 2>/dev/null || true)

  printf '%s %s\n' "$instances" "$watches"
}

diagnostic_usage_percent() {
  local used="$1"
  local limit="$2"

  if ! diagnostic_is_unsigned_integer "$used" || ! diagnostic_is_unsigned_integer "$limit" || [ "$limit" -le 0 ]; then
    printf 'unknown\n'
    return
  fi

  printf '%s\n' $(( (used * 100) / limit ))
}

diagnostic_usage_meets_percent() {
  local used="$1"
  local limit="$2"
  local threshold="$3"

  if ! diagnostic_is_unsigned_integer "$used" ||
     ! diagnostic_is_unsigned_integer "$limit" ||
     ! diagnostic_is_unsigned_integer "$threshold" ||
     [ "$limit" -le 0 ]; then
    return 1
  fi

  [ $((used * 100)) -ge $((threshold * limit)) ]
}

inotify_guard_threshold_percent() {
  local threshold="${CODEX_INOTIFY_GUARD_THRESHOLD_PERCENT:-90}"

  if ! diagnostic_is_unsigned_integer "$threshold" || [ "$threshold" -lt 1 ] || [ "$threshold" -gt 100 ]; then
    threshold=90
  fi

  printf '%s\n' "$threshold"
}

inotify_pressure_unsafe_allowed() {
  [ "${CODEX_INOTIFY_PRESSURE_ALLOW_UNSAFE:-0}" = "1" ]
}

diagnostic_inotify_pressure_status() {
  local user_instances="$1"
  local max_user_instances="$2"
  local user_watches="$3"
  local max_user_watches="$4"
  local instance_percent="$5"
  local watch_percent="$6"
  local threshold="$7"
  local warning_threshold
  local max_percent=0
  local instance_unknown=0
  local watch_unknown=0

  if diagnostic_is_unsigned_integer "$instance_percent"; then
    if [ "$instance_percent" -gt "$max_percent" ]; then
      max_percent="$instance_percent"
    fi
  else
    instance_unknown=1
  fi
  if diagnostic_is_unsigned_integer "$watch_percent"; then
    if [ "$watch_percent" -gt "$max_percent" ]; then
      max_percent="$watch_percent"
    fi
  else
    watch_unknown=1
  fi

  if diagnostic_usage_meets_percent "$user_instances" "$max_user_instances" "$threshold" ||
     diagnostic_usage_meets_percent "$user_watches" "$max_user_watches" "$threshold"; then
    if inotify_pressure_unsafe_allowed; then
      printf 'override-active\n'
    else
      printf 'blocked\n'
    fi
    return
  fi

  if [ "$instance_unknown" -eq 1 ] && [ "$watch_unknown" -eq 1 ]; then
    printf 'unknown\n'
    return
  fi

  warning_threshold=$((threshold - 15))
  [ "$warning_threshold" -lt 1 ] && warning_threshold=1
  if [ "$instance_unknown" -eq 1 ] || [ "$watch_unknown" -eq 1 ] || [ "$max_percent" -ge "$warning_threshold" ]; then
    printf 'warning\n'
    return
  fi

  printf 'ok\n'
}

block_inotify_pressure_launch() {
  local usage
  local limits
  local user_instances="unknown"
  local user_watches="unknown"
  local max_user_instances="unknown"
  local max_user_watches="unknown"
  local instance_percent="unknown"
  local watch_percent="unknown"
  local threshold
  local pressure_status

  threshold="$(inotify_guard_threshold_percent)"
  usage="$(diagnostic_current_user_inotify_usage)"
  limits="$(diagnostic_inotify_limits)"
  read -r user_instances user_watches <<<"$usage"
  read -r max_user_instances max_user_watches <<<"$limits"
  instance_percent="$(diagnostic_usage_percent "$user_instances" "$max_user_instances")"
  watch_percent="$(diagnostic_usage_percent "$user_watches" "$max_user_watches")"
  pressure_status="$(diagnostic_inotify_pressure_status "$user_instances" "$max_user_instances" "$user_watches" "$max_user_watches" "$instance_percent" "$watch_percent" "$threshold")"

  if [ "$pressure_status" != "blocked" ]; then
    return 0
  fi

  echo "Codex for Linux refused to launch because inotify usage is already at or above ${threshold}%." >&2
  echo "Current user usage: instances=$user_instances/$max_user_instances (${instance_percent}%), watches=$user_watches/$max_user_watches (${watch_percent}%)." >&2
  echo "Close other file-watching apps or raise fs.inotify limits, then retry." >&2
  echo "Set CODEX_INOTIFY_PRESSURE_ALLOW_UNSAFE=1 only for controlled maintainer testing." >&2
  return 1
}

diagnostic_codex_inotify_fd_count() {
  local count=0
  local fd
  local pid
  local cmdline
  local user_uid

  if ! command -v find >/dev/null 2>&1; then
    printf '0\n'
    return
  fi

  user_uid="$(id -u 2>/dev/null || printf '')"
  [ -n "$user_uid" ] || {
    printf '0\n'
    return
  }

  while IFS= read -r fd; do
    [ -n "$fd" ] || continue
    pid="${fd#/proc/}"
    pid="${pid%%/*}"
    [ -r "/proc/$pid/cmdline" ] || continue
    cmdline="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    [ -n "$cmdline" ] || continue

    case "$cmdline" in
      *"$INSTALL_DIR/"*|*"codex-for-linux"*|*"CodexForLinux"*)
        count=$((count + 1))
        continue
        ;;
      *)
        ;;
    esac
  done < <(find /proc/[0-9]*/fd -maxdepth 1 -user "$user_uid" -lname 'anon_inode:inotify' -print 2>/dev/null || true)

  printf '%s\n' "$count"
}

diagnostics_impl() {
  local installed="no"
  local app_version="unknown"
  local electron_version="unknown"
  local session_label="X11 or unknown"
  local launch_status="session-clear"
  local launch_detail="desktop-session guard is clear; launch still requires the Codex CLI and runtime dependencies"
  local automations_status="best-effort"
  local automations_detail="local app must be running and able to access the selected project path"
  local file_watch_status="guarded"
  local file_watch_detail="recursive Linux fs.watch is disabled by default; set CODEX_LINUX_RECURSIVE_WATCH=1 only after raising inotify limits"
  local file_watch_plain="recursive Linux fs.watch is disabled by default."
  local file_watch_override_plain="set CODEX_LINUX_RECURSIVE_WATCH=1 only after raising inotify limits."
  local runtime_process_counts
  local runtime_memory_snapshot
  local runtime_electron_count=0
  local runtime_crashpad_count=0
  local runtime_webview_count=0
  local runtime_memory_process_count=0
  local runtime_memory_rss_kib_total=0
  local runtime_memory_max_rss_kib=0
  local webview_port="${CODEX_WEBVIEW_PORT:-5175}"
  local webview_port_status="unknown"
  local inotify_usage
  local inotify_limits
  local inotify_user_instances="unknown"
  local inotify_user_watches="unknown"
  local inotify_max_user_instances="unknown"
  local inotify_max_user_watches="unknown"
  local inotify_instance_usage_percent="unknown"
  local inotify_watch_usage_percent="unknown"
  local inotify_codex_fd_count=0
  local inotify_guard_threshold
  local inotify_pressure_status

  if [ "${CODEX_LINUX_RECURSIVE_WATCH:-0}" = "1" ]; then
    file_watch_status="override-active"
    file_watch_detail="CODEX_LINUX_RECURSIVE_WATCH=1 is set; monitor inotify usage and raise limits before using large workspaces"
    file_watch_plain="recursive Linux fs.watch override is active."
    file_watch_override_plain="CODEX_LINUX_RECURSIVE_WATCH=1 is set; monitor inotify usage."
  fi

  if runtime_installed; then
    installed="yes"
    app_version="$(metadata_field appVersion unknown)"
    electron_version="$(metadata_field electronVersion unknown)"
  else
    launch_status="blocked"
    launch_detail="runtime is not installed"
    automations_status="blocked"
    automations_detail="install the runtime before testing scheduled automations"
  fi

  if host_is_kde_wayland_session; then
    session_label="KDE Wayland"
    if [ "$installed" = "yes" ]; then
      if ! runtime_has_kde_wayland_guard; then
        launch_status="blocked"
        launch_detail="installed runtime launcher lacks the KDE Wayland crash guard; run codex-linux update --force before launching"
        automations_status="blocked"
        automations_detail="installed runtime launcher lacks the KDE Wayland crash guard"
      elif ! host_kde_wayland_unsafe_allowed; then
        launch_status="blocked"
        launch_detail="KDE Wayland crash guard prevents launch to avoid a KWin restart"
        automations_status="blocked"
        automations_detail="automations need the local app running; the crash guard blocks launch on this session"
      else
        launch_status="unsafe-override"
        launch_detail="maintainer override is set; use only in a disposable session"
        automations_status="unsafe-override"
        automations_detail="automation testing is possible only with the unsafe maintainer override"
      fi
    fi
  elif host_is_wayland_session; then
    session_label="Wayland"
  fi

  runtime_process_counts="$(diagnostic_runtime_process_counts)"
  read -r runtime_electron_count runtime_crashpad_count runtime_webview_count <<<"$runtime_process_counts"
  runtime_memory_snapshot="$(diagnostic_runtime_memory_snapshot)"
  read -r runtime_memory_process_count runtime_memory_rss_kib_total runtime_memory_max_rss_kib <<<"$runtime_memory_snapshot"
  webview_port_status="$(diagnostic_webview_port_status)"
  inotify_usage="$(diagnostic_current_user_inotify_usage)"
  inotify_limits="$(diagnostic_inotify_limits)"
  read -r inotify_user_instances inotify_user_watches <<<"$inotify_usage"
  read -r inotify_max_user_instances inotify_max_user_watches <<<"$inotify_limits"
  inotify_instance_usage_percent="$(diagnostic_usage_percent "$inotify_user_instances" "$inotify_max_user_instances")"
  inotify_watch_usage_percent="$(diagnostic_usage_percent "$inotify_user_watches" "$inotify_max_user_watches")"
  inotify_guard_threshold="$(inotify_guard_threshold_percent)"
  inotify_pressure_status="$(diagnostic_inotify_pressure_status "$inotify_user_instances" "$inotify_max_user_instances" "$inotify_user_watches" "$inotify_max_user_watches" "$inotify_instance_usage_percent" "$inotify_watch_usage_percent" "$inotify_guard_threshold")"
  inotify_codex_fd_count="$(diagnostic_codex_inotify_fd_count)"

  if [ "$installed" = "yes" ] && [ "$launch_status" != "blocked" ] && [ "$inotify_pressure_status" = "blocked" ]; then
    launch_status="blocked"
    launch_detail="inotify usage is at or above ${inotify_guard_threshold}%; close file watchers or raise limits before launch"
    automations_status="blocked"
    automations_detail="inotify pressure guard blocks launch until file-watch capacity is available"
  elif [ "$installed" = "yes" ] && [ "$launch_status" = "session-clear" ] && [ "$inotify_pressure_status" = "override-active" ]; then
    launch_status="unsafe-override"
    launch_detail="inotify pressure override is set; monitor file-watch capacity during launch"
    automations_status="unsafe-override"
    automations_detail="automation testing is possible only with the inotify pressure override"
  fi

  if [ "$PRINT_JSON" -eq 1 ]; then
    node - "$installed" "$app_version" "$electron_version" "$session_label" "$launch_status" "$launch_detail" "$automations_status" "$automations_detail" "$file_watch_status" "$file_watch_detail" "$runtime_electron_count" "$runtime_crashpad_count" "$runtime_webview_count" "$runtime_memory_process_count" "$runtime_memory_rss_kib_total" "$runtime_memory_max_rss_kib" "$webview_port" "$webview_port_status" "$inotify_max_user_instances" "$inotify_max_user_watches" "$inotify_codex_fd_count" "$inotify_user_instances" "$inotify_user_watches" "$inotify_instance_usage_percent" "$inotify_watch_usage_percent" "$inotify_guard_threshold" "$inotify_pressure_status" "$(inotify_pressure_unsafe_allowed && printf true || printf false)" <<'NODE'
const [
  installed,
  appVersion,
  electronVersion,
  session,
  launchStatus,
  launchDetail,
  automationsStatus,
  automationsDetail,
  fileWatchStatus,
  fileWatchDetail,
  runtimeElectronCount,
  runtimeCrashpadCount,
  runtimeWebviewCount,
  runtimeMemoryProcessCount,
  runtimeMemoryRssKibTotal,
  runtimeMemoryMaxRssKib,
  webviewPort,
  webviewPortStatus,
  inotifyMaxUserInstances,
  inotifyMaxUserWatches,
  inotifyCodexFdCount,
  inotifyUserInstances,
  inotifyUserWatches,
  inotifyInstanceUsagePercent,
  inotifyWatchUsagePercent,
  inotifyGuardThreshold,
  inotifyPressureStatus,
  inotifyPressureOverride,
] = process.argv.slice(2);

function maybeNumber(value) {
  return /^[0-9]+$/.test(String(value)) ? Number(value) : null;
}

console.log(JSON.stringify({
  installed: installed === "yes",
  appVersion,
  electronVersion,
  session,
  launchSafety: {
    status: launchStatus,
    detail: launchDetail,
  },
  features: {
    appshots: {
      status: "not-claimed-on-linux",
      detail: "official Codex docs currently describe Appshots as macOS-only",
    },
    computerUse: {
      status: "not-claimed-on-linux",
      detail: "official Codex docs currently describe Computer Use as macOS/Windows-only",
    },
    automations: {
      status: automationsStatus,
      detail: automationsDetail,
    },
  },
  fileWatching: {
    status: fileWatchStatus,
    detail: fileWatchDetail,
  },
  runtimeHealth: {
    processes: {
      electron: maybeNumber(runtimeElectronCount),
      crashpad: maybeNumber(runtimeCrashpadCount),
      webviewServer: maybeNumber(runtimeWebviewCount),
    },
    memory: {
      processCount: maybeNumber(runtimeMemoryProcessCount),
      rssKibTotal: maybeNumber(runtimeMemoryRssKibTotal),
      maxRssKib: maybeNumber(runtimeMemoryMaxRssKib),
    },
    webviewPort: {
      port: maybeNumber(webviewPort),
      status: webviewPortStatus,
    },
    inotify: {
      maxUserInstances: maybeNumber(inotifyMaxUserInstances),
      maxUserWatches: maybeNumber(inotifyMaxUserWatches),
      userInstances: maybeNumber(inotifyUserInstances),
      userWatches: maybeNumber(inotifyUserWatches),
      instanceUsagePercent: maybeNumber(inotifyInstanceUsagePercent),
      watchUsagePercent: maybeNumber(inotifyWatchUsagePercent),
      codexRelatedFdCount: maybeNumber(inotifyCodexFdCount),
      pressure: {
        status: inotifyPressureStatus,
        guardThresholdPercent: maybeNumber(inotifyGuardThreshold),
        override: inotifyPressureOverride === "true",
      },
    },
  },
}, null, 2));
NODE
    return
  fi

  cat <<EOF
Codex for Linux diagnostics

Install:        $installed
App version:    $app_version
Electron:       $electron_version
Session:        $session_label
Launch safety:  $launch_status - $launch_detail

Feature status:
  Appshots:     not claimed on Linux - official Codex docs currently describe Appshots as macOS-only
  Computer Use: not claimed on Linux - official Codex docs currently describe Computer Use as macOS/Windows-only
  Automations:  $automations_status - $automations_detail

Runtime safety:
  File watching: $file_watch_plain
  Override: $file_watch_override_plain

Runtime health:
  Processes: electron=$runtime_electron_count crashpad=$runtime_crashpad_count webview=$runtime_webview_count
  Memory: processes=$runtime_memory_process_count rss_kib_total=$runtime_memory_rss_kib_total max_rss_kib=$runtime_memory_max_rss_kib
  Webview port: $webview_port $webview_port_status
  Inotify: max_user_instances=$inotify_max_user_instances max_user_watches=$inotify_max_user_watches user_instances=$inotify_user_instances user_watches=$inotify_user_watches instance_usage=${inotify_instance_usage_percent}% watch_usage=${inotify_watch_usage_percent}% pressure=$inotify_pressure_status threshold=${inotify_guard_threshold}% codex_related_fds=$inotify_codex_fd_count
EOF
}

resolve_host_compiler() {
  local env_name="$1"
  local override="$2"
  local default_cmd="$3"
  local resolved

  if [ -n "$override" ]; then
    if resolved="$(command -v "$override" 2>/dev/null)"; then
      readlink -f "$resolved"
      return
    fi
    if [ -x "$override" ]; then
      readlink -f "$override"
      return
    fi
    die "$env_name points to a compiler that is not executable or on PATH: $override"
  fi

  command -v "$default_cmd" || die "Could not find $default_cmd for native rebuild."
}

prepare_workdir() {
  mkdir -p "$OUTPUT_ROOT" "$CACHE_DIR" "$STATE_DIR" "$LOG_DIR"
  WORK_DIR="$(mktemp -d)"

  if [ "$FRESH" -eq 1 ]; then
    log "Removing cached DMGs. Existing runtime will be replaced only after a successful rebuild."
    rm -f "$CACHE_DIR"/Codex*.dmg
    rm -f "$CACHE_DIR"/Codex*.dmg.metadata.json
  fi
}

assert_safe_install_dir() {
  local install_dir="${1:-$INSTALL_DIR}"
  local resolved_install
  local resolved_home
  resolved_home="$(readlink -f "$HOME")"

  mkdir -p "$(dirname "$install_dir")"
  resolved_install="$(readlink -m "$install_dir")"

  case "$resolved_install" in
    ""|"/"|"$resolved_home"|"$DATA_HOME"|"$CACHE_HOME"|"$STATE_HOME"|"$OUTPUT_ROOT")
      die "Refusing to remove unsafe install directory: $resolved_install"
      ;;
  esac
}

create_build_install_dir() {
  local final_parent
  final_parent="$(dirname "$INSTALL_DIR")"
  mkdir -p "$final_parent"
  BUILD_INSTALL_DIR="$(mktemp -d "$final_parent/.codex-for-linux-new.XXXXXX")"
  printf '%s\n' "$BUILD_INSTALL_DIR"
}

arch_key() {
  case "$(uname -m)" in
    x86_64|amd64)
      printf 'x64\n'
      ;;
    aarch64|arm64)
      printf 'arm64\n'
      ;;
    *)
      die "Unsupported Linux architecture: $(uname -m)"
      ;;
  esac
}

upstream_metadata() {
  local output="$1"
  local arch
  arch="$(arch_key)"

  if [ -n "${CODEX_DMG_URL:-}" ]; then
    node "$METADATA_CLI" --arch "$arch" --url "$CODEX_DMG_URL" --output "$output"
  else
    node "$METADATA_CLI" --arch "$arch" --output "$output"
  fi
}

metadata_equal() {
  local left="$1"
  local right="$2"

  [ -f "$left" ] && [ -f "$right" ] || return 1

  node - "$left" "$right" <<'NODE'
const fs = require("fs");
const left = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const right = JSON.parse(fs.readFileSync(process.argv[3], "utf8"));
const keys = ["arch", "url", "etag", "lastModified", "contentLength", "contentType"];
process.exit(keys.every((key) => String(left[key] || "") === String(right[key] || "")) ? 0 : 1);
NODE
}

local_dmg_metadata() {
  local dmg="$1"
  local output="$2"
  local arch
  arch="$(arch_key)"

  node - "$dmg" "$output" "$arch" <<'NODE'
const fs = require("fs");
const path = require("path");
const [dmgPath, outputPath, arch] = process.argv.slice(2);
const stat = fs.statSync(dmgPath);
const metadata = {
  arch,
  url: `file://${path.resolve(dmgPath)}`,
  etag: null,
  lastModified: stat.mtime.toUTCString(),
  contentLength: stat.size,
  contentType: "application/x-apple-diskimage",
  localFile: true,
};
fs.writeFileSync(outputPath, `${JSON.stringify(metadata, null, 2)}\n`);
NODE
}

cached_dmg_current() {
  local dmg="$1"
  local current_metadata="$2"
  local cached_metadata="$dmg.metadata.json"
  local expected_size
  local actual_size

  [ -s "$dmg" ] || return 1
  metadata_equal "$current_metadata" "$cached_metadata" || return 1

  expected_size="$(node -e 'const fs=require("fs"); const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); console.log(m.contentLength || "")' "$current_metadata")"
  actual_size="$(wc -c <"$dmg" | tr -d ' ')"
  [ -z "$expected_size" ] || [ "$expected_size" = "$actual_size" ]
}

resolve_dmg_path() {
  local metadata_path="$1"
  local url
  local default_name
  local cached_metadata

  if [ -n "$DMG_PATH" ]; then
    [ -f "$DMG_PATH" ] || die "Provided DMG not found: $DMG_PATH"
    readlink -f "$DMG_PATH"
    return
  fi

  url="$(node -e 'const fs=require("fs"); const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); console.log(m.url)' "$metadata_path")"
  default_name="$(node -e 'const fs=require("fs"); const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); console.log(m.arch==="x64" ? "Codex-latest-x64.dmg" : "Codex.dmg")' "$metadata_path")"
  DMG_PATH="$CACHE_DIR/$default_name"

  if [ -s "$DMG_PATH" ]; then
    if cached_dmg_current "$DMG_PATH" "$metadata_path"; then
      log "Using cached DMG: $DMG_PATH"
      readlink -f "$DMG_PATH"
      return
    fi
    warn "Cached DMG does not match current upstream metadata. Redownloading."
    rm -f "$DMG_PATH" "$DMG_PATH.metadata.json"
  fi

  log "Downloading official Codex App DMG for $(arch_key)."
  curl -L --progress-bar --connect-timeout 30 --max-time 1200 -o "$DMG_PATH" "$url"
  [ -s "$DMG_PATH" ] || die "Download failed or produced an empty DMG: $DMG_PATH"
  cached_metadata="$DMG_PATH.metadata.json"
  cp "$metadata_path" "$cached_metadata"
  readlink -f "$DMG_PATH"
}

run_logged() {
  local label="$1"
  local log_path="$2"
  local status=0
  shift 2

  mkdir -p "$(dirname "$log_path")"
  if "$@" >"$log_path" 2>&1; then
    return 0
  fi

  status=$?
  warn "$label failed with exit code $status."
  warn "Full log: $log_path"
  warn "Last 80 log lines:"
  tail -n 80 "$log_path" >&2 || true
  return "$status"
}

extract_dmg() {
  local dmg="$1"
  local extract_dir="$WORK_DIR/dmg"
  local seven_zip_log="$LOG_DIR/7z-extract.log"
  local seven_zip_status=0
  local app_dir

  mkdir -p "$extract_dir"
  if "$SEVEN_ZIP_CMD" x -y -snl "$dmg" -o"$extract_dir" >"$seven_zip_log" 2>&1; then
    :
  else
    seven_zip_status=$?
  fi

  app_dir="$(find "$extract_dir" -maxdepth 5 -name '*.app' -type d | head -n 1 || true)"
  [ -n "$app_dir" ] || {
    cat "$seven_zip_log" >&2 || true
    die "Could not find a .app bundle after extracting the DMG."
  }

  if [ "$seven_zip_status" -ne 0 ]; then
    warn "7-Zip returned exit code $seven_zip_status but the app bundle was found. Continuing."
  fi

  printf '%s\n' "$app_dir"
}

detect_electron_version() {
  local extracted_asar_dir="$1"
  local detected

  if [ -n "${CODEX_ELECTRON_VERSION:-}" ]; then
    printf '%s\n' "$CODEX_ELECTRON_VERSION"
    return
  fi

  detected="$(node -e '
const pkg = require(process.argv[1] + "/package.json");
const candidates = [
  pkg.electronVersion,
  pkg.build && pkg.build.electronVersion,
  pkg.dependencies && pkg.dependencies.electron,
  pkg.devDependencies && pkg.devDependencies.electron,
];
const found = candidates.find((value) => typeof value === "string" && value.length > 0);
console.log(found ? found.replace(/^[^0-9]*/, "") : "");
' "$extracted_asar_dir" 2>/dev/null || true)"

  if [ -n "$detected" ]; then
    printf '%s\n' "$detected"
  else
    warn "Could not detect Electron version from app bundle. Falling back to 40.0.0."
    printf '40.0.0\n'
  fi
}

version_less_than() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]
}

resolve_better_sqlite3_version() {
  local detected="$1"
  local electron="$2"
  local electron_major="${electron%%.*}"
  local detected_major="${detected%%.*}"
  local electron_42_floor="12.11.1"

  if [ -n "${CODEX_BETTER_SQLITE3_VERSION:-}" ]; then
    printf '%s\n' "$CODEX_BETTER_SQLITE3_VERSION"
    return
  fi

  if [ "$electron_major" -ge 42 ] && [ "$detected_major" = "12" ] && version_less_than "$detected" "$electron_42_floor"; then
    printf '%s\n' "$electron_42_floor"
  else
    printf '%s\n' "$detected"
  fi
}

build_native_modules() {
  local extracted_asar_dir="$1"
  local electron_version="$2"
  local native_build_dir="$WORK_DIR/native-build"
  local better_version
  local better_build_version
  local pty_version
  local native_cc
  local native_cxx

  better_version="$(node -p "require(process.argv[1] + '/node_modules/better-sqlite3/package.json').version" "$extracted_asar_dir" 2>/dev/null || true)"
  pty_version="$(node -p "require(process.argv[1] + '/node_modules/node-pty/package.json').version" "$extracted_asar_dir" 2>/dev/null || true)"
  [ -n "$better_version" ] || die "Could not detect better-sqlite3 in the app bundle."
  [ -n "$pty_version" ] || die "Could not detect node-pty in the app bundle."

  better_build_version="$(resolve_better_sqlite3_version "$better_version" "$electron_version")"
  native_cc="$(resolve_host_compiler CODEX_LINUX_CC "${CODEX_LINUX_CC:-}" gcc)"
  native_cxx="$(resolve_host_compiler CODEX_LINUX_CXX "${CODEX_LINUX_CXX:-}" g++)"
  mkdir -p "$native_build_dir"

  cat >"$native_build_dir/package.json" <<EOF
{"name":"codex-linux-native-build","private":true,"version":"0.0.0","dependencies":{"electron":"$electron_version","better-sqlite3":"$better_build_version","node-pty":"$pty_version"}}
EOF

  log "Rebuilding native modules for Electron $electron_version."
  if [ "$better_build_version" != "$better_version" ]; then
    warn "Using better-sqlite3@$better_build_version for compatibility; upstream bundle contains $better_version."
  fi
  log "Using native build compilers: CC=$native_cc CXX=$native_cxx."

  (
    cd "$native_build_dir"
    run_logged "npm install for native rebuild" "$LOG_DIR/native-npm-install.log" env \
      CC="$native_cc" \
      CXX="$native_cxx" \
      npm_config_cc="$native_cc" \
      npm_config_cxx="$native_cxx" \
      npm install --ignore-scripts --no-audit --no-fund
    run_logged "electron native rebuild" "$LOG_DIR/native-electron-rebuild.log" env \
      CC="$native_cc" \
      CXX="$native_cxx" \
      npm_config_cc="$native_cc" \
      npm_config_cxx="$native_cxx" \
      npm_config_build_from_source=true \
      npx --yes @electron/rebuild -v "$electron_version" --force
  )

  [ -f "$(find "$native_build_dir/node_modules/better-sqlite3" -name 'better_sqlite3.node' -type f | head -n 1)" ] || die "better-sqlite3 rebuild did not produce better_sqlite3.node."
  [ -f "$(find "$native_build_dir/node_modules/node-pty" -name 'pty.node' -type f | head -n 1)" ] || die "node-pty rebuild did not produce pty.node."

  rm -rf "$extracted_asar_dir/node_modules/better-sqlite3" "$extracted_asar_dir/node_modules/node-pty"
  cp -R "$native_build_dir/node_modules/better-sqlite3" "$extracted_asar_dir/node_modules/"
  cp -R "$native_build_dir/node_modules/node-pty" "$extracted_asar_dir/node_modules/"
}

patch_app_bundle() {
  local app_dir="$1"
  local resources_dir="$app_dir/Contents/Resources"
  local app_asar="$resources_dir/app.asar"
  local extracted_asar_dir="$WORK_DIR/app-asar"
  local electron_version

  [ -f "$app_asar" ] || die "app.asar not found in $resources_dir."

  log "Extracting app.asar."
  npx --yes @electron/asar extract "$app_asar" "$extracted_asar_dir" >&2

  if [ -d "$resources_dir/app.asar.unpacked" ]; then
    cp -R "$resources_dir/app.asar.unpacked" "$WORK_DIR/"
    cp -R "$resources_dir/app.asar.unpacked/." "$extracted_asar_dir/"
  fi

  electron_version="$(detect_electron_version "$extracted_asar_dir")"
  log "Using Electron $electron_version."

  rm -rf "$extracted_asar_dir/node_modules/sparkle-darwin" 2>/dev/null || true
  find "$extracted_asar_dir" -name 'sparkle.node' -delete 2>/dev/null || true

  build_native_modules "$extracted_asar_dir" "$electron_version"

  log "Applying Linux compatibility patches."
  node "$PATCHER" "$extracted_asar_dir" >&2

  log "Packing patched app.asar."
  rm -rf "$WORK_DIR/app.asar" "$WORK_DIR/app.asar.unpacked"
  npx --yes @electron/asar pack \
    "$extracted_asar_dir" \
    "$WORK_DIR/app.asar" \
    --unpack "{*.node,*.so,*.dylib}" \
    --unpack-dir "{node_modules/better-sqlite3,node_modules/node-pty}" >&2

  printf '%s\n' "$electron_version"
}

download_electron_runtime() {
  local electron_version="$1"
  local electron_arch
  local electron_zip
  local electron_url
  local electron_shasums
  local electron_shasums_url
  local electron_zip_name
  local expected_sha256
  local actual_sha256

  case "$(uname -m)" in
    x86_64|amd64)
      electron_arch="x64"
      ;;
    aarch64|arm64)
      electron_arch="arm64"
      ;;
    *)
      die "Unsupported Electron runtime architecture: $(uname -m)"
      ;;
  esac

  electron_zip="$CACHE_DIR/electron-v${electron_version}-linux-${electron_arch}.zip"
  electron_zip_name="$(basename "$electron_zip")"
  electron_url="https://github.com/electron/electron/releases/download/v${electron_version}/electron-v${electron_version}-linux-${electron_arch}.zip"
  electron_shasums="$CACHE_DIR/electron-v${electron_version}-SHASUMS256.txt"
  electron_shasums_url="https://github.com/electron/electron/releases/download/v${electron_version}/SHASUMS256.txt"

  assert_safe_install_dir "$INSTALL_DIR"
  rm -rf "$INSTALL_DIR"
  mkdir -p "$INSTALL_DIR"

  if [ ! -s "$electron_shasums" ]; then
    log "Downloading Electron SHASUMS256.txt for v${electron_version}."
    curl -L --fail --show-error --connect-timeout 30 --max-time 120 -o "$electron_shasums" "$electron_shasums_url"
  else
    log "Using cached Electron SHASUMS256.txt: $electron_shasums"
  fi

  if [ ! -s "$electron_zip" ]; then
    log "Downloading Electron runtime v${electron_version} for linux-${electron_arch}."
    curl -L --fail --show-error --progress-bar --connect-timeout 30 --max-time 1200 -o "$electron_zip" "$electron_url"
  else
    log "Using cached Electron runtime: $electron_zip"
  fi

  expected_sha256="$(awk -v file="$electron_zip_name" '$2 == file || $2 == "*" file { print $1 }' "$electron_shasums" | head -n 1)"
  [ -n "$expected_sha256" ] || die "Electron checksum not found for $electron_zip_name in $electron_shasums."
  actual_sha256="$(sha256sum "$electron_zip" | awk '{ print $1 }')"
  if [ "$actual_sha256" != "$expected_sha256" ]; then
    rm -f "$electron_zip"
    die "Electron runtime checksum mismatch for $electron_zip_name."
  fi
  log "Verified Electron runtime checksum: $electron_zip_name"

  (
    cd "$INSTALL_DIR"
    unzip -qo "$electron_zip"
  )
}

install_app_files() {
  local extracted_asar_dir="$WORK_DIR/app-asar"
  local icon_source

  mkdir -p "$INSTALL_DIR/resources" "$INSTALL_DIR/content/webview"
  cp "$WORK_DIR/app.asar" "$INSTALL_DIR/resources/app.asar"

  if [ -d "$WORK_DIR/app.asar.unpacked" ]; then
    cp -R "$WORK_DIR/app.asar.unpacked" "$INSTALL_DIR/resources/"
  fi

  if [ -d "$extracted_asar_dir/webview" ]; then
    cp -R "$extracted_asar_dir/webview/." "$INSTALL_DIR/content/webview/"
    icon_source="$(find "$INSTALL_DIR/content/webview/assets" -maxdepth 1 -type f -name 'app-*.png' | head -n 1 || true)"
    if [ -n "$icon_source" ]; then
      cp "$icon_source" "$INSTALL_DIR/codex.png"
    fi

    if [ -f "$INSTALL_DIR/content/webview/index.html" ]; then
      sed -i 's/--startup-background: transparent/--startup-background: #1e1e1e/' "$INSTALL_DIR/content/webview/index.html"
    fi
  else
    warn "No webview directory found in the app bundle."
  fi

  if [ ! -f "$INSTALL_DIR/codex.png" ] && [ -f "$FALLBACK_ICON" ]; then
    cp "$FALLBACK_ICON" "$INSTALL_DIR/codex-for-linux.svg"
  fi
}

create_launcher() {
  cat >"$INSTALL_DIR/start.sh" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WEBVIEW_DIR="$SCRIPT_DIR/content/webview"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/codex-for-linux"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/codex-for-linux"
WEBVIEW_PORT="${CODEX_WEBVIEW_PORT:-5175}"
WEBVIEW_PID_FILE="$STATE_DIR/webview.pid"
LAUNCHER_LOG_FILE="$LOG_DIR/launcher.log"
ELECTRON_PID=""
ELECTRON_HAS_PROCESS_GROUP=0
ELECTRON_PROCESS_GROUP_ID=""
WEBVIEW_SERVER_STARTED=0
CRASHPAD_BASELINE_PIDS=""

mkdir -p "$STATE_DIR" "$LOG_DIR"

launcher_log() {
  printf '%s %s\n' "$(date -Is)" "$*" >>"$LAUNCHER_LOG_FILE" 2>/dev/null || true
}

resolve_codex_cli() {
  local candidate

  if [ -n "${CODEX_CLI_PATH:-}" ] && [ -x "$CODEX_CLI_PATH" ]; then
    printf '%s\n' "$CODEX_CLI_PATH"
    return 0
  fi

  if command -v codex >/dev/null 2>&1; then
    command -v codex
    return 0
  fi

  for candidate in \
    "$HOME/.local/bin/codex" \
    "$HOME/.local/share/pnpm/codex" \
    "$HOME/.nvm/versions/node/current/bin/codex" \
    /opt/homebrew/bin/codex \
    /home/linuxbrew/.linuxbrew/bin/codex \
    /usr/local/bin/codex \
    /usr/bin/codex
  do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

port_open() {
  python3 - "$WEBVIEW_PORT" <<'PY'
import socket
import sys

port = int(sys.argv[1])
with socket.socket() as sock:
    sock.settimeout(0.2)
    try:
        sock.connect(("127.0.0.1", port))
    except OSError:
        sys.exit(1)
sys.exit(0)
PY
}

clear_stale_webview_pid() {
  local pid
  if [ ! -f "$WEBVIEW_PID_FILE" ]; then
    return
  fi
  pid="$(cat "$WEBVIEW_PID_FILE" 2>/dev/null || true)"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$WEBVIEW_PID_FILE"
  fi
}

stop_webview_server() {
  local pid
  if [ "${WEBVIEW_SERVER_STARTED:-0}" != "1" ]; then
    return
  fi
  pid="$(cat "$WEBVIEW_PID_FILE" 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    launcher_log "Stopping local webview server pid=$pid"
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$WEBVIEW_PID_FILE"
  WEBVIEW_SERVER_STARTED=0
}

stop_electron() {
  local pid="$ELECTRON_PID"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    if [ "${ELECTRON_HAS_PROCESS_GROUP:-0}" = "1" ]; then
      ELECTRON_PROCESS_GROUP_ID="$pid"
      launcher_log "Stopping Electron process group pid=$pid"
      kill -TERM -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    else
      launcher_log "Stopping Electron pid=$pid"
      kill "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  fi
  ELECTRON_PID=""
  ELECTRON_HAS_PROCESS_GROUP=0
}

snapshot_crashpad_handlers() {
  local pid
  local pgid
  local cmd

  CRASHPAD_BASELINE_PIDS=""
  while read -r pid pgid cmd; do
    case "$cmd" in
      "$SCRIPT_DIR/chrome_crashpad_handler"|"$SCRIPT_DIR/chrome_crashpad_handler "*)
        CRASHPAD_BASELINE_PIDS="${CRASHPAD_BASELINE_PIDS}${CRASHPAD_BASELINE_PIDS:+ }$pid"
        ;;
    esac
  done < <(ps -eo pid=,pgid=,args=)
}

crashpad_pid_was_preexisting() {
  local target="$1"
  local existing

  for existing in $CRASHPAD_BASELINE_PIDS; do
    [ "$existing" = "$target" ] && return 0
  done

  return 1
}

stop_crashpad_handlers() {
  local pid
  local pgid
  local cmd

  ps -eo pid=,pgid=,args= | while read -r pid pgid cmd; do
    case "$cmd" in
      "$SCRIPT_DIR/chrome_crashpad_handler"|"$SCRIPT_DIR/chrome_crashpad_handler "*)
        if [ -n "${ELECTRON_PROCESS_GROUP_ID:-}" ] && [ "$pgid" != "$ELECTRON_PROCESS_GROUP_ID" ]; then
          continue
        fi
        if [ -z "${ELECTRON_PROCESS_GROUP_ID:-}" ] && crashpad_pid_was_preexisting "$pid"; then
          continue
        fi
        launcher_log "Stopping crashpad handler pid=$pid"
        kill "$pid" 2>/dev/null || true
        ;;
    esac
  done
}

cleanup_launcher() {
  stop_electron
  stop_crashpad_handlers
  stop_webview_server
}

handle_launcher_signal() {
  local status="$1"
  trap - EXIT INT TERM
  cleanup_launcher
  exit "$status"
}

start_webview_server() {
  local attempt

  if [ ! -d "$WEBVIEW_DIR" ]; then
    return 0
  fi

  clear_stale_webview_pid

  if port_open; then
    launcher_log "Local webview port $WEBVIEW_PORT is already in use; continuing with existing listener"
    return 0
  fi

  launcher_log "Starting local webview server on 127.0.0.1:$WEBVIEW_PORT"
  (
    cd "$WEBVIEW_DIR"
    exec python3 -m http.server "$WEBVIEW_PORT" --bind 127.0.0.1 >/dev/null 2>&1
  ) &

  echo "$!" >"$WEBVIEW_PID_FILE"
  WEBVIEW_SERVER_STARTED=1

  for attempt in $(seq 1 50); do
    if port_open; then
      return 0
    fi
    sleep 0.1
  done

  echo "Failed to start local webview server on 127.0.0.1:$WEBVIEW_PORT" >&2
  echo "See launcher log: $LAUNCHER_LOG_FILE" >&2
  echo "Check the port owner: ss -ltnp 'sport = :$WEBVIEW_PORT'" >&2
  echo "Or retry with another port: CODEX_WEBVIEW_PORT=5176 codex-linux launch" >&2
  launcher_log "Failed to start local webview server on 127.0.0.1:$WEBVIEW_PORT"
  return 1
}

is_wayland_session() {
  [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

is_kde_wayland_session() {
  local desktop_values
  local desktop_lc

  is_wayland_session || return 1

  if [ "${KDE_FULL_SESSION:-}" = "true" ] || [ -n "${KDE_SESSION_VERSION:-}" ]; then
    return 0
  fi

  desktop_values="${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:${DESKTOP_SESSION:-}"
  desktop_lc="$(printf '%s' "$desktop_values" | tr '[:upper:]' '[:lower:]')"
  case "$desktop_lc" in
    *kde*|*plasma*)
      return 0
      ;;
  esac

  return 1
}

kde_wayland_unsafe_allowed() {
  [ "${CODEX_KDE_WAYLAND_ALLOW_UNSAFE:-0}" = "1" ] || [ "${CODEX_KWIN_ALLOW_UNSAFE:-0}" = "1" ]
}

is_unsigned_integer() {
  case "${1:-}" in
    ""|*[!0-9]*)
      return 1
      ;;
    0|[1-9]*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

read_inotify_limit() {
  local file="$1"
  local value

  if [ -r "$file" ]; then
    value="$(tr -d '[:space:]' <"$file")"
    if is_unsigned_integer "$value"; then
      printf '%s\n' "$value"
      return
    fi
  fi

  printf 'unknown\n'
}

inotify_limits() {
  if [ -n "${CODEX_LINUX_INOTIFY_LIMITS_FIXTURE:-}" ]; then
    printf '%s\n' "$CODEX_LINUX_INOTIFY_LIMITS_FIXTURE"
    return
  fi

  printf '%s %s\n' \
    "$(read_inotify_limit /proc/sys/fs/inotify/max_user_instances)" \
    "$(read_inotify_limit /proc/sys/fs/inotify/max_user_watches)"
}

current_user_inotify_usage() {
  local user_uid
  local instances=0
  local watches=0
  local fd
  local fdinfo
  local watch_count

  if [ -n "${CODEX_LINUX_INOTIFY_USAGE_FIXTURE:-}" ]; then
    printf '%s\n' "$CODEX_LINUX_INOTIFY_USAGE_FIXTURE"
    return
  fi

  if ! command -v find >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
    printf 'unknown unknown\n'
    return
  fi

  user_uid="$(id -u 2>/dev/null || printf '')"
  [ -n "$user_uid" ] || {
    printf 'unknown unknown\n'
    return
  }

  while IFS= read -r fd; do
    [ -n "$fd" ] || continue
    instances=$((instances + 1))
    fdinfo="${fd/\/fd\//\/fdinfo\/}"
    if [ -r "$fdinfo" ]; then
      watch_count="$(awk 'BEGIN { count = 0 } /^inotify/ { count++ } END { print count }' "$fdinfo" 2>/dev/null || printf '0')"
      if is_unsigned_integer "$watch_count"; then
        watches=$((watches + watch_count))
      fi
    fi
  done < <(find /proc/[0-9]*/fd -maxdepth 1 -user "$user_uid" -lname 'anon_inode:inotify' -print 2>/dev/null || true)

  printf '%s %s\n' "$instances" "$watches"
}

usage_percent() {
  local used="$1"
  local limit="$2"

  if ! is_unsigned_integer "$used" || ! is_unsigned_integer "$limit" || [ "$limit" -le 0 ]; then
    printf 'unknown\n'
    return
  fi

  printf '%s\n' $(( (used * 100) / limit ))
}

usage_meets_percent() {
  local used="$1"
  local limit="$2"
  local threshold="$3"

  if ! is_unsigned_integer "$used" ||
     ! is_unsigned_integer "$limit" ||
     ! is_unsigned_integer "$threshold" ||
     [ "$limit" -le 0 ]; then
    return 1
  fi

  [ $((used * 100)) -ge $((threshold * limit)) ]
}

inotify_guard_threshold_percent() {
  local threshold="${CODEX_INOTIFY_GUARD_THRESHOLD_PERCENT:-90}"

  if ! is_unsigned_integer "$threshold" || [ "$threshold" -lt 1 ] || [ "$threshold" -gt 100 ]; then
    threshold=90
  fi

  printf '%s\n' "$threshold"
}

inotify_pressure_unsafe_allowed() {
  [ "${CODEX_INOTIFY_PRESSURE_ALLOW_UNSAFE:-0}" = "1" ]
}

block_inotify_pressure_launch() {
  local usage
  local limits
  local user_instances="unknown"
  local user_watches="unknown"
  local max_user_instances="unknown"
  local max_user_watches="unknown"
  local instance_percent="unknown"
  local watch_percent="unknown"
  local threshold

  inotify_pressure_unsafe_allowed && return 0

  threshold="$(inotify_guard_threshold_percent)"
  usage="$(current_user_inotify_usage)"
  limits="$(inotify_limits)"
  read -r user_instances user_watches <<<"$usage"
  read -r max_user_instances max_user_watches <<<"$limits"
  instance_percent="$(usage_percent "$user_instances" "$max_user_instances")"
  watch_percent="$(usage_percent "$user_watches" "$max_user_watches")"

  if usage_meets_percent "$user_instances" "$max_user_instances" "$threshold" ||
     usage_meets_percent "$user_watches" "$max_user_watches" "$threshold"; then
    echo "Codex for Linux refused to launch because inotify usage is already at or above ${threshold}%." >&2
    echo "Current user usage: instances=$user_instances/$max_user_instances (${instance_percent}%), watches=$user_watches/$max_user_watches (${watch_percent}%)." >&2
    echo "Close other file-watching apps or raise fs.inotify limits, then retry." >&2
    echo "Set CODEX_INOTIFY_PRESSURE_ALLOW_UNSAFE=1 only for controlled maintainer testing." >&2
    launcher_log "Blocked launch because inotify pressure is high: instances=$user_instances/$max_user_instances watches=$user_watches/$max_user_watches threshold=${threshold}%"

    if command -v notify-send >/dev/null 2>&1; then
      notify-send \
        "Codex for Linux blocked" \
        "Inotify usage is already high. Close file watchers or raise limits, then retry." \
        >/dev/null 2>&1 || true
    fi

    return 1
  fi

  return 0
}

block_kde_wayland_launch() {
  local message
  message="Codex for Linux refused to launch on KDE Wayland because this runtime has been observed to crash KWin."

  echo "$message" >&2
  echo "This guard prevents a compositor restart. See $LAUNCHER_LOG_FILE." >&2
  echo "Use a non-KDE Wayland session or an X11 session for normal use." >&2
  echo "Set CODEX_KDE_WAYLAND_ALLOW_UNSAFE=1 only for controlled maintainer testing in a disposable session." >&2
  launcher_log "$message"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send \
      "Codex for Linux blocked" \
      "KDE Wayland crash guard refused to launch. Use X11/non-KDE Wayland, or see the launcher log." \
      >/dev/null 2>&1 || true
  fi
}

main() {
  local codex_cli_path

  codex_cli_path="$(resolve_codex_cli || true)"
  if [ -z "$codex_cli_path" ]; then
    echo "Codex CLI not found. Install @openai/codex first, then retry." >&2
    echo "Example: npm i -g @openai/codex" >&2
    exit 1
  fi

  export CODEX_CLI_PATH="$codex_cli_path"
  export ELECTRON_FORCE_IS_PACKAGED=1
  export NODE_ENV=production
  export CHROME_DESKTOP="${CHROME_DESKTOP:-codex-for-linux.desktop}"
  unset ELECTRON_RUN_AS_NODE

  local session_is_wayland=0
  local session_is_kde_wayland=0
  if is_wayland_session; then
    session_is_wayland=1
  fi
  if is_kde_wayland_session; then
    session_is_kde_wayland=1
  fi

  if [ "$session_is_kde_wayland" -eq 1 ] && ! kde_wayland_unsafe_allowed; then
    block_kde_wayland_launch
    exit 78
  fi

  if ! block_inotify_pressure_launch; then
    exit 78
  fi

  trap cleanup_launcher EXIT
  trap 'handle_launcher_signal 130' INT
  trap 'handle_launcher_signal 143' TERM

  start_webview_server

  local ozone_platform
  local ozone_platform_hint
  if [ "$session_is_kde_wayland" -eq 1 ]; then
    # Maintainer override path only. Prefer native Wayland here to avoid the
    # XWayland XCB SHAPE/Input path implicated by KWin crash logs. Do not let
    # CODEX_OZONE_PLATFORM=x11 re-enter that path under the normal override.
    ozone_platform="wayland"
    ozone_platform_hint="${CODEX_OZONE_PLATFORM_HINT:-auto}"
  elif [ "$session_is_wayland" -eq 1 ]; then
    # Prefer the same XWayland-compatible default as the working community
    # launchers. Native Wayland can swallow text focus on some KDE/Plasma
    # setups; users can still opt in with CODEX_OZONE_PLATFORM=wayland.
    ozone_platform="${CODEX_OZONE_PLATFORM:-x11}"
    ozone_platform_hint="${CODEX_OZONE_PLATFORM_HINT:-auto}"
  else
    ozone_platform="${CODEX_OZONE_PLATFORM:-x11}"
    ozone_platform_hint="${CODEX_OZONE_PLATFORM_HINT:-x11}"
  fi

  local extra_flags=()

  # Bypass buggy IME on Linux if explicitly requested (can break standard keyboard typing)
  if [ "${CODEX_DISABLE_IME:-0}" -eq 1 ]; then
    export GTK_IM_MODULE=none
    export QT_IM_MODULE=none
    export XMODIFIERS="@im=none"
    extra_flags+=(
      "--disable-gtk-ime"
      "--disable-wayland-ime"
    )
  fi

  if [ "$ozone_platform" = "wayland" ] && { [ "${CODEX_WAYLAND_TEXT_INPUT:-0}" = "1" ] || [ "$session_is_kde_wayland" -eq 1 ]; }; then
    # Native Wayland text input remains opt-in until physical keyboard focus is
    # reliable across the target Linux desktops. KDE Wayland only reaches this
    # branch behind the explicit KWin crash-risk override.
    extra_flags+=("--wayland-text-input-version=3")
  fi

  snapshot_crashpad_handlers

  setsid "$SCRIPT_DIR/electron" \
    --no-sandbox \
    --class=codex-for-linux \
    --app-id=com.bulkheados.CodexForLinux \
    --ozone-platform="$ozone_platform" \
    --ozone-platform-hint="$ozone_platform_hint" \
    --disable-gpu-sandbox \
    "${extra_flags[@]}" \
    "$@" &
  ELECTRON_PID="$!"
  ELECTRON_HAS_PROCESS_GROUP=1
  ELECTRON_PROCESS_GROUP_ID="$ELECTRON_PID"

  local electron_status=0
  wait "$ELECTRON_PID" || electron_status="$?"
  ELECTRON_PID=""
  ELECTRON_HAS_PROCESS_GROUP=0
  return "$electron_status"
}

main "$@"
EOF

  chmod +x "$INSTALL_DIR/start.sh"
}

install_desktop_entry() {
  local temp_file="$WORK_DIR/codex-for-linux.desktop"
  local icon_path="$INSTALL_DIR/codex.png"

  [ -x "$INSTALL_DIR/start.sh" ] || die "Launcher not found: $INSTALL_DIR/start.sh"
  [ -f "$DESKTOP_TEMPLATE" ] || die "Desktop template not found: $DESKTOP_TEMPLATE"
  if [ ! -f "$icon_path" ] && [ -f "$INSTALL_DIR/codex-for-linux.svg" ]; then
    icon_path="$INSTALL_DIR/codex-for-linux.svg"
  fi

  mkdir -p "$(dirname "$DESKTOP_FILE_PATH")"
  sed \
    -e "s|__EXEC__|env CODEX_KDE_WAYLAND_ALLOW_UNSAFE=1 $INSTALL_DIR/start.sh|g" \
    -e "s|__ICON__|$icon_path|g" \
    "$DESKTOP_TEMPLATE" >"$temp_file"

  if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$temp_file"
  fi

  cp "$temp_file" "$DESKTOP_FILE_PATH"
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$(dirname "$DESKTOP_FILE_PATH")" >/dev/null 2>&1 || true
  fi
  if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default "$(basename "$DESKTOP_FILE_PATH")" x-scheme-handler/codex >/dev/null 2>&1 || true
  fi
  log "Desktop entry installed: $DESKTOP_FILE_PATH"
}

launch_command_hint() {
  if command -v codex-linux >/dev/null 2>&1; then
    printf 'codex-linux launch\n'
  else
    printf 'bash %q launch\n' "$SCRIPT_PATH"
  fi
}

write_install_metadata() {
  local upstream_metadata_path="$1"
  local electron_version="$2"
  local extracted_asar_dir="$WORK_DIR/app-asar"
  local output="$INSTALL_DIR/metadata.json"

  node - "$upstream_metadata_path" "$output" "$electron_version" "$extracted_asar_dir" <<'NODE'
const fs = require("fs");
const [upstreamPath, outputPath, electronVersion, extractedAsarDir] = process.argv.slice(2);
const upstream = JSON.parse(fs.readFileSync(upstreamPath, "utf8"));
let appVersion = "unknown";
try {
  appVersion = require(`${extractedAsarDir}/package.json`).version || "unknown";
} catch {
  appVersion = "unknown";
}
const metadata = {
  app: "Codex for Linux and friends",
  appId: "com.bulkheados.CodexForLinux",
  unofficial: true,
  installedAt: new Date().toISOString(),
  upstream,
  appVersion,
  electronVersion,
};
fs.writeFileSync(outputPath, `${JSON.stringify(metadata, null, 2)}\n`);
NODE
}

activate_runtime() {
  local final_install_dir="$1"
  local build_install_dir="$2"
  local backup_dir=""

  assert_safe_install_dir "$final_install_dir"
  mkdir -p "$(dirname "$final_install_dir")"

  if [ -e "$final_install_dir" ]; then
    backup_dir="$WORK_DIR/previous-runtime"
    mv "$final_install_dir" "$backup_dir"
  fi

  if mv "$build_install_dir" "$final_install_dir"; then
    BUILD_INSTALL_DIR=""
    rm -rf "$backup_dir"
    return
  fi

  if [ -n "$backup_dir" ] && [ -e "$backup_dir" ]; then
    mv "$backup_dir" "$final_install_dir" || true
  fi
  die "Failed to activate new runtime; previous runtime was restored."
}

install_impl() {
  local upstream_path
  local final_install_dir="$INSTALL_DIR"
  local dmg
  local app_dir
  local electron_version

  doctor_impl
  prepare_workdir
  upstream_path="$WORK_DIR/upstream.json"

  if [ -n "$DMG_PATH" ]; then
    dmg="$(resolve_dmg_path "$upstream_path")"
    local_dmg_metadata "$dmg" "$upstream_path"
  else
    upstream_metadata "$upstream_path"
    dmg="$(resolve_dmg_path "$upstream_path")"
  fi

  INSTALL_DIR="$(create_build_install_dir)"
  app_dir="$(extract_dmg "$dmg")"
  electron_version="$(patch_app_bundle "$app_dir")"
  download_electron_runtime "$electron_version"
  install_app_files
  create_launcher
  write_install_metadata "$upstream_path" "$electron_version"
  activate_runtime "$final_install_dir" "$INSTALL_DIR"
  INSTALL_DIR="$final_install_dir"

  if [ "$SKIP_DESKTOP" -eq 0 ]; then
    install_desktop_entry
  fi

  cat >&2 <<EOF

$APP_NAME is ready.
Launcher:      $INSTALL_DIR/start.sh
Desktop entry: $DESKTOP_FILE_PATH
Runtime dir:   $INSTALL_DIR

Start it with:
  $(launch_command_hint)
EOF
}

status_json() {
  if [ -f "$INSTALL_DIR/metadata.json" ]; then
    cat "$INSTALL_DIR/metadata.json"
  else
    printf '{"installed":false,"installDir":"%s"}\n' "$INSTALL_DIR"
  fi
}

status_impl() {
  if [ "$PRINT_JSON" -eq 1 ]; then
    status_json
    return
  fi

  if [ ! -f "$INSTALL_DIR/metadata.json" ]; then
    printf 'Not installed.\nInstall dir: %s\n' "$INSTALL_DIR"
    return
  fi

  node - "$INSTALL_DIR/metadata.json" <<'NODE'
const fs = require("fs");
const metadata = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
console.log(`Installed:     yes`);
console.log(`App version:   ${metadata.appVersion}`);
console.log(`Electron:      ${metadata.electronVersion}`);
console.log(`Upstream URL:  ${metadata.upstream && metadata.upstream.url}`);
console.log(`Upstream ETag: ${metadata.upstream && metadata.upstream.etag || "unknown"}`);
console.log(`Installed at:  ${metadata.installedAt}`);
NODE
  printf 'Install dir:   %s\n' "$INSTALL_DIR"
}

update_needed() {
  local current_path="$1"
  local installed_path="$2"

  if [ "$FORCE" -eq 1 ]; then
    printf 'yes\n'
    return
  fi

  if [ ! -f "$installed_path" ]; then
    printf 'yes\n'
    return
  fi

  node - "$current_path" "$installed_path" <<'NODE'
const fs = require("fs");
const current = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const installed = JSON.parse(fs.readFileSync(process.argv[3], "utf8")).upstream || {};
const keys = ["url", "etag", "lastModified", "contentLength"];
const changed = keys.some((key) => String(current[key] || "") !== String(installed[key] || ""));
console.log(changed ? "yes" : "no");
NODE
}

update_impl() {
  local upstream_path
  local needed

  doctor_impl
  prepare_workdir
  upstream_path="$WORK_DIR/upstream.json"
  upstream_metadata "$upstream_path"
  needed="$(update_needed "$upstream_path" "$INSTALL_DIR/metadata.json")"

  if [ "$needed" != "yes" ]; then
    log "Already current according to upstream URL, ETag, Last-Modified, and Content-Length."
    return
  fi

  log "Upstream changed or no install exists. Rebuilding local runtime."
  rm -rf "$WORK_DIR"
  WORK_DIR=""
  FRESH=1
  install_impl
}

launch_impl() {
  [ -x "$INSTALL_DIR/start.sh" ] || die "Runtime is not installed. Run: codex-linux install"
  if host_is_kde_wayland_session && ! host_kde_wayland_unsafe_allowed && ! runtime_has_kde_wayland_guard; then
    echo "Codex for Linux refused to launch on KDE Wayland because the installed runtime launcher lacks the KWin crash guard." >&2
    echo "Run: codex-linux update --force" >&2
    echo "Do not launch the existing desktop entry until the runtime has been rebuilt." >&2
    exit 78
  fi
  if ! block_inotify_pressure_launch; then
    exit 78
  fi
  exec "$INSTALL_DIR/start.sh"
}

uninstall_impl() {
  assert_safe_install_dir "$INSTALL_DIR"
  rm -rf "$INSTALL_DIR"
  rm -f "$DESKTOP_FILE_PATH"
  log "Removed runtime and desktop entry."
  warn "Cache retained at $CACHE_DIR. Remove it manually if you want to delete downloaded DMGs."
}

main() {
  local command="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$command" in
    install)
      parse_options "$@"
      install_impl
      ;;
    update)
      parse_options "$@"
      update_impl
      ;;
    launch)
      parse_options "$@"
      launch_impl
      ;;
    status)
      parse_options "$@"
      status_impl
      ;;
    diagnostics)
      parse_options "$@"
      diagnostics_impl
      ;;
    doctor)
      parse_options "$@"
      doctor_impl
      ;;
    uninstall)
      parse_options "$@"
      uninstall_impl
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      die "Unknown command: $command"
      ;;
  esac
}

main "$@"
